@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using CloudConfigurationHub.Application.Projects
@using Mediator
@inject ISender Sender
@inject NavigationManager NavigationManager

@if (isLoading) {
    <div class="demo-empty">正在加载...</div>
}
else if (InitialView == "configs") {
    <div class="demo-workbench ConfigsWorkbench">
        <div class="demo-page-head">
            <div>
                <h1>@L("配置管理", "Configs")</h1>
                <p>@L("选择项目", "Select project")</p>
            </div>
            <div class="demo-combobox" @onfocusout="CloseProjectPickerSoon">
                <input class="demo-input" value="@ProjectPickerText" placeholder="@L("搜索项目", "Search projects")" @onfocus="OpenProjectPicker" @oninput="OnProjectPickerInput" />
                @if (projectPickerOpen) {
                    <div class="demo-combobox-menu">
                        @if (FilteredProjectOptions().Count == 0) {
                            <div class="demo-combobox-empty">@L("暂无数据", "No data")</div>
                        }
                        @foreach (var item in FilteredProjectOptions()) {
                            <button class="@(selectedProjectId == item.Id ? "active" : null)" type="button" @onclick="() => PickProject(item.Id)">@item.Name</button>
                        }
                    </div>
                }
            </div>
        </div>

        @if (SelectedProject is null) {
            <div class="demo-empty">@L("请先在“项目管理”中创建一个项目", "Create a project first")</div>
        }
        else {
            var project = SelectedProject;
            <div class="demo-mode-row">
                <div class="demo-segmented">
                    <button class="@(configMode == "env" ? "active" : null)" type="button" @onclick='() => configMode = "env"'>
                        <svg aria-hidden="true" viewBox="0 0 24 24"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><path d="M6 6h.01"/><path d="M6 18h.01"/></svg>
                        @L("按环境", "By env")
                    </button>
                    <button class="@(configMode == "config" ? "active" : null)" type="button" @onclick='() => configMode = "config"'>
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.5-9.17 4.17a2 2 0 0 1-1.66 0L2 12.5"/><path d="m22 17.5-9.17 4.17a2 2 0 0 1-1.66 0L2 17.5"/></svg>
                        @L("按配置", "By config")
                    </button>
                </div>
                <p>@(configMode == "env" ? L("选择一个环境，管理该环境下的全部配置", "Select one environment and manage all configs") : L("选择一个配置项，管理它在所有环境下的值", "Select one config and manage values across environments"))</p>
            </div>

            @if (project.Environments.Count == 0) {
                <div class="demo-empty">@L("该项目暂无环境，请先在项目设置中添加环境", "This project has no environments")</div>
            }
            else if (configMode == "env") {
                <div class="demo-config-panel">
                    <div class="demo-env-tabs">
                        @foreach (var env in project.Environments) {
                            <button class="@(selectedEnvironmentId == env.Id ? "active" : null)" type="button" @onclick="() => selectedEnvironmentId = env.Id">
                                <i style="@DotStyle(env.Key)"></i>@env.Name
                            </button>
                        }
                    </div>
                    <div class="demo-config-tools">
                        <div class="demo-search-wrap compact-search">
                            <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></span>
                            <input class="demo-input" placeholder="@L("搜索配置键", "Search config keys")" @bind="configQuery" @bind:event="oninput" />
                        </div>
                        <button class="demo-button" type="button" @onclick="OpenNewConfig">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                            @L("新建配置项", "New config")
                        </button>
                    </div>
                    <div class="demo-table-card">
                        <table>
                            <thead>
                                <tr>
                                    <th>KEY</th>
                                    <th>@L("值", "Value") · @CurrentEnvironmentName(project)</th>
                                    <th class="hide-sm">@L("更新于", "Updated")</th>
                                    <th class="right">@L("操作", "Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (FilteredConfigs(project).Count == 0) {
                                    <tr><td colspan="4" class="demo-table-empty">@L("暂无数据", "No data")</td></tr>
                                }
                                @foreach (var config in FilteredConfigs(project)) {
                                    <tr>
                                        <td>
                                            <strong class="mono">@ConfigDisplayKey(config)</strong>
                                            @if (!string.IsNullOrWhiteSpace(config.Description)) {
                                                <p>@config.Description</p>
                                            }
                                        </td>
                                        <td>
                                            <input class="demo-input mono compact" value="@CurrentValue(config)" @onchange="e => SaveDraftValueAsync(project, config, selectedEnvironmentId!.Value, e.Value?.ToString() ?? string.Empty)" />
                                        </td>
                                        <td class="mono hide-sm">@FormatDate(project.CreatedAt)</td>
                                        <td class="right">
                                            <button class="demo-icon-button" type="button" @onclick="() => OpenEditConfig(config)" aria-label="@L("编辑", "Edit")">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                            </button>
                                            <button class="demo-icon-button danger-text" type="button" @onclick="() => deleteConfigTarget = config.Id" aria-label="@L("删除", "Delete")">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else {
                var visibleConfigs = FilteredConfigs(project);
                var selectedConfig = visibleConfigs.FirstOrDefault(item => item.Id == selectedConfigurationId) ?? visibleConfigs.FirstOrDefault();
                <div class="demo-config-split">
                    <aside class="demo-config-list">
                        <header>
                            <span>@L("选择配置项", "Select config")</span>
                            <button class="demo-icon-button" type="button" @onclick="OpenNewConfig" aria-label="@L("新建配置项", "New config")">
                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                            </button>
                        </header>
                        <div class="demo-config-list-search">
                            <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></span>
                            <input class="demo-input compact mono" placeholder="@L("搜索配置键", "Search config keys")" @bind="configQuery" @bind:event="oninput" />
                        </div>
                        @if (visibleConfigs.Count == 0) {
                            <p>@L("暂无数据", "No data")</p>
                        }
                        @foreach (var config in visibleConfigs) {
                            <button class="@(selectedConfig?.Id == config.Id ? "active" : null)" type="button" @onclick="() => selectedConfigurationId = config.Id">@ConfigDisplayKey(config)</button>
                        }
                    </aside>
                    <section class="demo-config-detail">
                        @if (selectedConfig is null) {
                            <div class="demo-empty inner">@L("暂无数据", "No data")</div>
                        }
                        else {
                            <div class="demo-detail-head">
                                <div>
                                    <h3 class="mono">@ConfigDisplayKey(selectedConfig)</h3>
                                    <p>@(string.IsNullOrWhiteSpace(selectedConfig.Description) ? L("各环境取值", "Values across environments") : selectedConfig.Description)</p>
                                </div>
                                <div>
                                    <button class="demo-icon-button" type="button" @onclick="() => OpenEditConfig(selectedConfig)" aria-label="@L("编辑", "Edit")">
                                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                    </button>
                                    <button class="demo-icon-button danger-text" type="button" @onclick="() => deleteConfigTarget = selectedConfig.Id" aria-label="@L("删除", "Delete")">
                                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="demo-env-value-list">
                                <p class="mono">@L("各环境取值", "Values across environments")</p>
                                @foreach (var env in project.Environments) {
                                    var value = selectedConfig.Values.SingleOrDefault(item => item.EnvironmentId == env.Id)?.DisplayValue ?? string.Empty;
                                    <label>
                                        <span><i style="@DotStyle(env.Key)"></i>@env.Name</span>
                                        <input class="demo-input mono compact" value="@value" @onchange="e => SaveDraftValueAsync(project, selectedConfig, env.Id, e.Value?.ToString() ?? string.Empty)" />
                                    </label>
                                }
                            </div>
                        }
                    </section>
                </div>
            }
        }
    </div>
}
else {
    <div class="demo-workbench ProjectsWorkbench">
        <div class="demo-page-head">
            <div>
                <h1>@L("项目管理", "Projects")</h1>
                <p>@projects.Count @L("个项目 · 管理所有项目及其环境", "projects · Manage all projects and environments")</p>
            </div>
            <button class="demo-button large" type="button" @onclick="OpenNewProject">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                @L("新建项目", "New project")
            </button>
        </div>

        <div class="demo-search-wrap">
            <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></span>
            <input class="demo-input" placeholder="@L("搜索项目名称或标识", "Search by name or key")" @bind="projectQuery" @bind:event="oninput" />
        </div>

        @if (FilteredProjects().Count == 0) {
            <div class="demo-empty">@L("暂无数据", "No data")</div>
        }
        else {
            <div class="demo-project-grid">
                @foreach (var project in FilteredProjects()) {
                    <article class="demo-project-card">
                        <div class="demo-card-top">
                            <div>
                                <h3>@project.Name</h3>
                                <p class="mono">@project.Key</p>
                            </div>
                            <div class="demo-card-actions">
                                <button class="demo-icon-button" type="button" @onclick="() => OpenEditProject(project)" aria-label="@L("编辑", "Edit")">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                </button>
                                <button class="demo-icon-button danger-text" type="button" @onclick="() => deleteProjectTarget = project.Id" aria-label="@L("删除", "Delete")">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                </button>
                            </div>
                        </div>
                        <p class="demo-card-desc">@(string.IsNullOrWhiteSpace(project.Description) ? "—" : project.Description)</p>
                        <div class="demo-env-chips">
                            @if (project.Environments?.Count > 0) {
                                @foreach (var env in project.Environments) {
                                    <span><i style="@DotStyle(env.Key)"></i>@env.Name</span>
                                }
                            }
                            else {
                                <small>—</small>
                            }
                        </div>
                        <div class="demo-card-meta">
                            <span class="mono">@project.EnvironmentCount @L("个环境", "envs") · @project.ConfigurationCount @L("项配置", "configs")</span>
                        </div>
                        <div class="demo-card-bottom">
                            <span>@L("创建于", "Created") @FormatDate(project.CreatedAt)</span>
                            <button class="demo-button outline small" type="button" @onclick="() => GoConfig(project.Id)">@L("管理配置", "Manage config")</button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
}

@if (projectModalOpen) {
    <div class="demo-modal-root">
        <button class="demo-modal-scrim" type="button" @onclick="CloseProjectModal" aria-label="@L("关闭", "Close")"></button>
        <section class="demo-modal project-modal" role="dialog" aria-modal="true" aria-label="@ProjectModalTitle">
            <header class="demo-modal-header">
                <h2>@ProjectModalTitle</h2>
                <button type="button" class="demo-icon-button" @onclick="CloseProjectModal" aria-label="@L("关闭", "Close")">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </header>
            <div class="demo-modal-body">
                <label class="demo-field">
                    <span>@L("名称", "Name")</span>
                    <input class="demo-input" @bind="projectForm.Name" />
                </label>
                <label class="demo-field">
                    <span>@L("标识", "Key")</span>
                    <input class="demo-input mono" @bind="projectForm.Key" />
                    <small>@L("项目唯一标识，用于 API 调用", "Unique project key for API calls")</small>
                </label>
                <label class="demo-field">
                    <span>@L("描述", "Description") <em>@L("选填", "Optional")</em></span>
                    <textarea class="demo-input" rows="2" @bind="projectForm.Description"></textarea>
                </label>
                @if (editingProjectId is null) {
                    <label class="demo-field">
                        <span>@L("环境", "Environments")</span>
                        <input class="demo-input" placeholder="dev,test,prod" @bind="projectForm.EnvironmentNames" />
                        <small>@L("多个环境用逗号分隔", "Separate environments with commas")</small>
                    </label>
                }
                @if (!string.IsNullOrWhiteSpace(formError)) {
                    <p class="demo-error">@formError</p>
                }
            </div>
            <footer class="demo-modal-footer">
                <button class="demo-button outline" type="button" @onclick="CloseProjectModal">@L("取消", "Cancel")</button>
                <button class="demo-button" type="button" @onclick="SaveProjectAsync">@L("保存", "Save")</button>
            </footer>
        </section>
    </div>
}

@if (configModalOpen && SelectedProject is not null) {
    <div class="demo-modal-root">
        <button class="demo-modal-scrim" type="button" @onclick="CloseConfigModal" aria-label="@L("关闭", "Close")"></button>
        <section class="demo-modal config-modal" role="dialog" aria-modal="true" aria-label="@ConfigModalTitle">
            <header class="demo-modal-header">
                <h2>@ConfigModalTitle</h2>
                <button type="button" class="demo-icon-button" @onclick="CloseConfigModal" aria-label="@L("关闭", "Close")">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </header>
            <div class="demo-modal-body">
                <label class="demo-field">
                    <span>@L("标识", "Key")</span>
                    <input class="demo-input mono" placeholder="database.host" @bind="configForm.Key" />
                    <small>@L("配置键，项目内唯一", "Configuration key, unique within the project")</small>
                </label>
                <label class="demo-field">
                    <span>@L("描述", "Description") <em>@L("选填", "Optional")</em></span>
                    <textarea class="demo-input" rows="2" @bind="configForm.Description"></textarea>
                </label>
                <label class="demo-check">
                    <input type="checkbox" @bind="configForm.IsSensitive" />
                    <span>@L("敏感配置", "Sensitive config")</span>
                </label>
                <div class="demo-env-values">
                    <p>@L("环境取值", "Environment values")</p>
                    @foreach (var env in SelectedProject.Environments) {
                        <label>
                            <span><i style="@DotStyle(env.Key)"></i>@env.Name</span>
                            <input class="demo-input mono compact" value="@GetConfigFormValue(env.Id)" @oninput="e => SetConfigFormValue(env.Id, e.Value?.ToString() ?? string.Empty)" />
                        </label>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(formError)) {
                    <p class="demo-error">@formError</p>
                }
            </div>
            <footer class="demo-modal-footer">
                <button class="demo-button outline" type="button" @onclick="CloseConfigModal">@L("取消", "Cancel")</button>
                <button class="demo-button" type="button" @onclick="SaveConfigAsync">@L("保存", "Save")</button>
            </footer>
        </section>
    </div>
}

@if (deleteProjectTarget is not null || deleteConfigTarget is not null) {
    <div class="demo-modal-root">
        <button class="demo-modal-scrim" type="button" @onclick="CloseConfirm" aria-label="@L("关闭", "Close")"></button>
        <section class="demo-modal demo-confirm" role="dialog" aria-modal="true" aria-label="@L("删除确认", "Delete confirmation")">
            <header class="demo-modal-header">
                <h2>@L("删除", "Delete")</h2>
                <button type="button" class="demo-icon-button" @onclick="CloseConfirm" aria-label="@L("关闭", "Close")">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </header>
            <div class="demo-modal-body">
                <p>@(deleteProjectTarget is not null ? L("确定删除该项目吗？其下所有配置将一并删除，此操作不可恢复。", "Delete this project? All configurations under it will also be removed. This cannot be undone.") : L("确定删除该配置项吗？它在所有环境下的值都将被删除。", "Delete this config? Its values in all environments will be removed."))</p>
            </div>
            <footer class="demo-modal-footer">
                <button class="demo-button outline" type="button" @onclick="CloseConfirm">@L("取消", "Cancel")</button>
                <button class="demo-button danger" type="button" @onclick="ConfirmDeleteAsync">@L("删除", "Delete")</button>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter]
    public string InitialView { get; set; } = "projects";

    private IReadOnlyList<ProjectCard> projects = [];
    private readonly Dictionary<Guid, ProjectDetail> details = [];
    private bool isLoading = true;
    private string projectQuery = string.Empty;
    private string configQuery = string.Empty;
    private string projectPickerQuery = string.Empty;
    private bool projectPickerOpen;
    private Guid? selectedProjectId;
    private Guid? selectedEnvironmentId;
    private Guid? selectedConfigurationId;
    private string configMode = "config";
    private bool projectModalOpen;
    private bool configModalOpen;
    private Guid? editingProjectId;
    private Guid? editingConfigId;
    private Guid? deleteProjectTarget;
    private Guid? deleteConfigTarget;
    private string formError = string.Empty;
    private ProjectFormModel projectForm = new();
    private ConfigFormModel configForm = new();

    private ProjectDetail? SelectedProject =>
        selectedProjectId is { } id && details.TryGetValue(id, out var detail) ? detail : null;

    private string ProjectModalTitle => editingProjectId is null ? L("新建项目", "New project") : L("编辑项目", "Edit project");
    private string ConfigModalTitle => editingConfigId is null ? L("新建配置项", "New config") : L("编辑配置项", "Edit config");
    private string ProjectPickerText =>
        projectPickerOpen ? projectPickerQuery : projects.FirstOrDefault(item => item.Id == selectedProjectId)?.Name ?? string.Empty;

    protected override async Task OnInitializedAsync() {
        await ReloadAsync();
        isLoading = false;
    }

    private async Task ReloadAsync() {
        var list = await Sender.Send(new ListProjectsQuery(), CancellationToken.None);
        projects = list.Projects;
        details.Clear();
        foreach (var project in projects) {
            var detail = await Sender.Send(new GetProjectDetailQuery(project.Id), CancellationToken.None);
            if (detail is not null) {
                details[project.Id] = detail;
            }
        }

        selectedProjectId ??= projects.FirstOrDefault()?.Id;
        projectPickerQuery = projects.FirstOrDefault(item => item.Id == selectedProjectId)?.Name ?? string.Empty;
        if (SelectedProject is { } selected) {
            selectedEnvironmentId = selected.Environments.Any(item => item.Id == selectedEnvironmentId)
                ? selectedEnvironmentId
                : selected.Environments.FirstOrDefault()?.Id;
            selectedConfigurationId = selected.Configurations.Any(item => item.Id == selectedConfigurationId)
                ? selectedConfigurationId
                : selected.Configurations.FirstOrDefault()?.Id;
        }
    }

    private IReadOnlyList<ProjectCard> FilteredProjects() {
        var query = projectQuery.Trim();
        if (query.Length == 0) {
            return projects;
        }

        return projects
            .Where(project => project.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                || project.Key.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private IReadOnlyList<ProjectCard> FilteredProjectOptions() {
        var query = projectPickerQuery.Trim();
        if (query.Length == 0) {
            return projects;
        }

        return projects
            .Where(project => project.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                || project.Key.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private IReadOnlyList<ConfigurationDetail> FilteredConfigs(ProjectDetail project) {
        var query = configQuery.Trim();
        if (query.Length == 0) {
            return project.Configurations;
        }

        return project.Configurations
            .Where(config => ConfigDisplayKey(config).Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private void GoConfig(Guid projectId) {
        selectedProjectId = projectId;
        InitialView = "configs";
        selectedEnvironmentId = SelectedProject?.Environments.FirstOrDefault()?.Id;
        selectedConfigurationId = SelectedProject?.Configurations.FirstOrDefault()?.Id;
    }

    private void OnProjectChanged(ChangeEventArgs args) {
        if (Guid.TryParse(args.Value?.ToString(), out var id)) {
            selectedProjectId = id;
            selectedEnvironmentId = SelectedProject?.Environments.FirstOrDefault()?.Id;
            selectedConfigurationId = SelectedProject?.Configurations.FirstOrDefault()?.Id;
        }
    }

    private void OpenProjectPicker() {
        projectPickerOpen = true;
        projectPickerQuery = string.Empty;
    }

    private void OnProjectPickerInput(ChangeEventArgs args) {
        projectPickerOpen = true;
        projectPickerQuery = args.Value?.ToString() ?? string.Empty;
    }

    private async Task CloseProjectPickerSoon() {
        await Task.Delay(120);
        projectPickerOpen = false;
    }

    private void PickProject(Guid projectId) {
        selectedProjectId = projectId;
        projectPickerOpen = false;
        projectPickerQuery = projects.FirstOrDefault(item => item.Id == projectId)?.Name ?? string.Empty;
        selectedEnvironmentId = SelectedProject?.Environments.FirstOrDefault()?.Id;
        selectedConfigurationId = SelectedProject?.Configurations.FirstOrDefault()?.Id;
    }

    private void OpenNewProject() {
        editingProjectId = null;
        projectForm = new ProjectFormModel { EnvironmentNames = "dev,test,prod" };
        formError = string.Empty;
        projectModalOpen = true;
    }

    private void OpenEditProject(ProjectCard project) {
        editingProjectId = project.Id;
        projectForm = new ProjectFormModel {
            Name = project.Name,
            Key = project.Key,
            Description = project.Description
        };
        formError = string.Empty;
        projectModalOpen = true;
    }

    private async Task SaveProjectAsync() {
        if (string.IsNullOrWhiteSpace(projectForm.Name)) {
            formError = L("请输入名称", "Enter a name");
            return;
        }

        var key = string.IsNullOrWhiteSpace(projectForm.Key) ? Slug(projectForm.Name) : projectForm.Key;
        if (editingProjectId is { } projectId) {
            await Sender.Send(new UpdateProjectCommand(projectId, projectForm.Name.Trim(), key, projectForm.Description.Trim()), CancellationToken.None);
        }
        else {
            var created = await Sender.Send(new CreateProjectCommand(projectForm.Name.Trim(), key, projectForm.Description.Trim()), CancellationToken.None);
            foreach (var name in SplitNames(projectForm.EnvironmentNames)) {
                await Sender.Send(new AddEnvironmentCommand(created.Id, name, Slug(name)), CancellationToken.None);
            }
        }

        CloseProjectModal();
        await ReloadAsync();
    }

    private void OpenNewConfig() {
        editingConfigId = null;
        configForm = new ConfigFormModel();
        formError = string.Empty;
        configModalOpen = true;
    }

    private void OpenEditConfig(ConfigurationDetail config) {
        editingConfigId = config.Id;
        configForm = new ConfigFormModel {
            Key = ConfigDisplayKey(config),
            Description = config.Description,
            IsSensitive = config.IsSensitive,
            Values = config.Values.ToDictionary(item => item.EnvironmentId, item => item.DisplayValue)
        };
        formError = string.Empty;
        configModalOpen = true;
    }

    private async Task SaveConfigAsync() {
        if (selectedProjectId is null || string.IsNullOrWhiteSpace(configForm.Key)) {
            formError = L("请输入配置键", "Enter a config key");
            return;
        }

        var (group, key) = SplitConfigKey(configForm.Key);
        if (editingConfigId is { } configId) {
            await Sender.Send(new UpdateConfigurationCommand(
                selectedProjectId.Value,
                configId,
                group,
                key,
                configForm.IsSensitive,
                configForm.Description.Trim(),
                configForm.Values),
                CancellationToken.None);
        }
        else {
            var created = await Sender.Send(new AddConfigurationCommand(
                selectedProjectId.Value,
                group,
                key,
                configForm.IsSensitive,
                configForm.Description.Trim()),
                CancellationToken.None);
            foreach (var (environmentId, value) in configForm.Values) {
                await Sender.Send(new SetDraftValueCommand(selectedProjectId.Value, environmentId, created.Id, value), CancellationToken.None);
            }
        }

        CloseConfigModal();
        await ReloadAsync();
    }

    private async Task SaveDraftValueAsync(ProjectDetail project, ConfigurationDetail config, Guid environmentId, string value) {
        await Sender.Send(new SetDraftValueCommand(project.Id, environmentId, config.Id, value), CancellationToken.None);
        await ReloadAsync();
    }

    private async Task ConfirmDeleteAsync() {
        if (deleteProjectTarget is { } projectId) {
            await Sender.Send(new DeleteProjectCommand(projectId), CancellationToken.None);
            selectedProjectId = null;
        }
        else if (deleteConfigTarget is { } configId && selectedProjectId is { } projectIdForConfig) {
            await Sender.Send(new DeleteConfigurationCommand(projectIdForConfig, configId), CancellationToken.None);
            selectedConfigurationId = null;
        }

        CloseConfirm();
        await ReloadAsync();
    }

    private string CurrentEnvironmentName(ProjectDetail project) =>
        project.Environments.FirstOrDefault(item => item.Id == selectedEnvironmentId)?.Name ?? string.Empty;

    private string CurrentValue(ConfigurationDetail config) =>
        selectedEnvironmentId is { } envId
            ? config.Values.SingleOrDefault(item => item.EnvironmentId == envId)?.DisplayValue ?? string.Empty
            : string.Empty;

    private string GetConfigFormValue(Guid environmentId) =>
        configForm.Values.TryGetValue(environmentId, out var value) ? value : string.Empty;

    private void SetConfigFormValue(Guid environmentId, string value) {
        configForm.Values[environmentId] = value;
    }

    private static string ConfigDisplayKey(ConfigurationDetail config) =>
        string.IsNullOrWhiteSpace(config.Group) || config.Group == "default" ? config.Key : $"{config.Group}.{config.Key}";

    private static (string Group, string Key) SplitConfigKey(string value) {
        var normalized = value.Trim();
        var index = normalized.LastIndexOf('.');
        return index > 0
            ? (normalized[..index], normalized[(index + 1)..])
            : ("default", normalized);
    }

    private static string Slug(string value) =>
        string.Join('-', value.Trim().ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries));

    private static IReadOnlyList<string> SplitNames(string value) =>
        value.Split([',', '，', ';', '；'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private string FormatDate(DateTimeOffset value) {
        if (value == default) {
            return "—";
        }

        var local = value.ToLocalTime();
        return CurrentLanguage switch {
            "en" => local.ToString("MMM d, yyyy", CultureInfo.CurrentUICulture),
            "ja" => local.ToString("yyyy年M月d日", CultureInfo.CurrentUICulture),
            "ko" => local.ToString("yyyy. M. d.", CultureInfo.CurrentUICulture),
            "es" => local.ToString("d MMM yyyy", CultureInfo.CurrentUICulture),
            _ => local.ToString("yyyy年M月d日")
        };
    }

    private string CurrentLanguage => ResolveLanguage();

    private string ResolveLanguage() {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var culture = query.TryGetValue("ui-culture", out var uiCulture)
            ? uiCulture.ToString()
            : query.TryGetValue("culture", out var routeCulture)
                ? routeCulture.ToString()
                : CultureInfo.CurrentUICulture.Name;
        return culture.Split('-', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.ToLowerInvariant()
            ?? CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    }

    private string L(string zh, string en) {
        if (CurrentLanguage == "en") {
            return en;
        }

        return CurrentLanguage switch {
            "ja" => Japanese.TryGetValue(zh, out var value) ? value : zh,
            "ko" => Korean.TryGetValue(zh, out var value) ? value : zh,
            "es" => Spanish.TryGetValue(zh, out var value) ? value : zh,
            _ => zh
        };
    }

