@inject IStringLocalizer<AppText> Texts

<details class="theme-switcher" data-theme-switcher aria-label="@Texts["Theme.Switcher"]">
    <summary title="@Texts["Theme.Switcher"]">
        <span class="theme-current system">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm0 0v17" />
            </svg>
        </span>
        <span class="theme-current light">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M12 7.25a4.75 4.75 0 1 0 0 9.5 4.75 4.75 0 0 0 0-9.5Z" />
                <path d="M12 2.75v2M12 19.25v2M4.75 4.75l1.4 1.4M17.85 17.85l1.4 1.4M2.75 12h2M19.25 12h2M4.75 19.25l1.4-1.4M17.85 6.15l1.4-1.4" />
            </svg>
        </span>
        <span class="theme-current dark">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M20.25 14.1A7.5 7.5 0 0 1 9.9 3.75 8.25 8.25 0 1 0 20.25 14.1Z" />
            </svg>
        </span>
    </summary>
    <div class="theme-menu">
        <button type="button" data-theme-option="system" title="@Texts["Theme.System"]" aria-label="@Texts["Theme.System"]">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm0 0v17" />
            </svg>
            <span>@Texts["Theme.System"]</span>
        </button>
        <button type="button" data-theme-option="light" title="@Texts["Theme.Light"]" aria-label="@Texts["Theme.Light"]">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M12 7.25a4.75 4.75 0 1 0 0 9.5 4.75 4.75 0 0 0 0-9.5Z" />
                <path d="M12 2.75v2M12 19.25v2M4.75 4.75l1.4 1.4M17.85 17.85l1.4 1.4M2.75 12h2M19.25 12h2M4.75 19.25l1.4-1.4M17.85 6.15l1.4-1.4" />
            </svg>
            <span>@Texts["Theme.Light"]</span>
        </button>
        <button type="button" data-theme-option="dark" title="@Texts["Theme.Dark"]" aria-label="@Texts["Theme.Dark"]">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M20.25 14.1A7.5 7.5 0 0 1 9.9 3.75 8.25 8.25 0 1 0 20.25 14.1Z" />
            </svg>
            <span>@Texts["Theme.Dark"]</span>
        </button>
    </div>
</details>
