@inherits LayoutComponentBase
@inject IStringLocalizer<AppText> Texts

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="cpa-topbar-status" aria-label="@Texts["TopNav.OperationalStatus"]">
                <span class="cpa-status-dot" aria-hidden="true"></span>
                <span>@Texts["TopNav.Connected"]</span>
                <span class="cpa-topbar-divider" aria-hidden="true"></span>
                <code>@Texts["TopNav.SdkBoundary"]</code>
            </div>
            <div class="top-row-actions">
                <ThemeSwitcher />
                <LanguageSwitcher AriaLabel="@Texts["Language.Switcher"]" />
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">@Texts["TopNav.About"]</a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Texts["BlazorError.Message"]
    <a href="." class="reload">@Texts["BlazorError.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />
