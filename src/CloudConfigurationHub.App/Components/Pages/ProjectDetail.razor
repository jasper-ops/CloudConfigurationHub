@page "/projects/{ProjectId:guid}"
@using CloudConfigurationHub.Application.Projects
@using ProjectDetailModel = CloudConfigurationHub.Application.Projects.ProjectDetail
@using Mediator
@inject ISender Sender
@inject ILogger<ProjectDetail> Logger
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["ProjectDetail.PageTitle"]</PageTitle>

<section class="admin-page control-surface">
    @if (isLoading) {
        <FluentCard Class="state-card">
            <FluentProgressRing />
            <p>@Texts["ProjectDetail.Loading"]</p>
        </FluentCard>
    }
    else if (project is null) {
        <FluentCard Class="state-card">
            <h2>@Texts["ProjectDetail.NotFoundTitle"]</h2>
            <p>@Texts["ProjectDetail.NotFoundDescription"]</p>
            <a class="primary-action" href="projects">@Texts["ProjectDetail.BackToProjects"]</a>
        </FluentCard>
    }
    else {
        <div class="admin-page-header command-hero detail-hero">
            <div>
                <p class="eyebrow">@Texts["ProjectDetail.Eyebrow"]</p>
                <h1>@project.Name</h1>
                <p class="page-description text-code">@project.Key</p>
            </div>
            <a class="secondary-action" href="projects">@Texts["ProjectDetail.BackToProjects"]</a>
        </div>

        <dl class="project-stats detail-stats">
            <div>
                <dt>@Texts["Projects.EnvironmentCount"]</dt>
                <dd>@project.Environments.Count</dd>
            </div>
            <div>
                <dt>@Texts["Projects.ConfigurationCount"]</dt>
                <dd>@project.Configurations.Count</dd>
            </div>
            <div>
                <dt>@Texts["ProjectDetail.ProjectKey"]</dt>
                <dd class="text-code">@project.Key</dd>
            </div>
        </dl>

        <div class="detail-layout">
            <FluentCard Class="detail-card command-card">
                <div class="section-heading">
                    <h2>@Texts["ProjectDetail.Environments"]</h2>
                    <a class="secondary-action compact" href="@($"projects/{ProjectId}/environments/new")">@Texts["ProjectDetail.AddEnvironment"]</a>
                </div>
                @if (project.Environments.Count == 0) {
                    <div class="mini-empty">
                        <div class="orb-icon small" aria-hidden="true"></div>
                        <p class="muted-text">@Texts["ProjectDetail.NoEnvironments"]</p>
                    </div>
                }
                else {
                    <div class="pill-list">
                        @foreach (var environment in project.Environments) {
                            <span class="info-pill">
                                @environment.Name <code>@environment.Key</code>
                                <a href="@($"projects/{ProjectId}/environments/{environment.Id}/drafts")">@Texts["DraftEdit.EditEnvironment"]</a>
                                <a href="@($"projects/{ProjectId}/environments/{environment.Id}/publish")">@Texts["PublishEnvironment.PublishEnvironment"]</a>
                            </span>
                        }
                    </div>
                }
            </FluentCard>

            <FluentCard Class="detail-card command-card">
                <div class="section-heading">
                    <h2>@Texts["ProjectDetail.Configurations"]</h2>
                    <a class="secondary-action compact" href="@($"projects/{ProjectId}/configurations/new")">@Texts["ProjectDetail.AddConfiguration"]</a>
                </div>
                @if (project.Configurations.Count == 0) {
                    <div class="mini-empty">
                        <div class="orb-icon small violet" aria-hidden="true"></div>
                        <p class="muted-text">@Texts["ProjectDetail.NoConfigurations"]</p>
                    </div>
                }
                else {
                    <div class="table-scroll">
                        <table class="detail-table">
                            <thead>
                                <tr>
                                    <th>@Texts["ProjectDetail.ConfigurationKey"]</th>
                                    <th>@Texts["ProjectDetail.Sensitive"]</th>
                                    @foreach (var environment in project.Environments) {
                                        <th>@environment.Key</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var configuration in project.Configurations) {
                                    <tr>
                                        <td>
                                            <code>@configuration.Group:@configuration.Key</code>
                                            <a class="table-action" href="@($"projects/{ProjectId}/configurations/{configuration.Id}/drafts")">@Texts["DraftEdit.EditConfiguration"]</a>
                                        </td>
                                        <td>
                                            <span class="status-pill @(configuration.IsSensitive ? "sensitive" : string.Empty)">
                                                @(configuration.IsSensitive ? Texts["Common.Yes"] : Texts["Common.No"])
                                            </span>
                                        </td>
                                        @foreach (var environment in project.Environments) {
                                            var value = configuration.Values.SingleOrDefault(item => item.EnvironmentId == environment.Id);
                                            <td>@(value?.HasValue == true ? value.DisplayValue : "—")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </FluentCard>
        </div>
    }
</section>

@code {
    /// <summary>
    /// 当前项目 ID。
    /// </summary>
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>
    /// 当前项目详情读取模型，项目不存在时为空。
    /// </summary>
    private ProjectDetailModel? project;

    /// <summary>
    /// 指示页面是否正在读取项目详情。
    /// </summary>
    private bool isLoading = true;

    /// <summary>
    /// 初始化页面时读取项目详情，并记录可观测日志。
    /// </summary>
    protected override async Task OnInitializedAsync() {
        Logger.LogInformation("管理端开始读取项目详情页面数据。ProjectId={ProjectId}", ProjectId);
        project = await Sender.Send(new GetProjectDetailQuery(ProjectId), CancellationToken.None);
        isLoading = false;
        Logger.LogInformation(
            "管理端项目详情页面数据读取完成。ProjectId={ProjectId}, Found={Found}",
            ProjectId,
            project is not null);
    }
}
