@page "/projects/{ProjectId:guid}/environments/{EnvironmentId:guid}/releases"
@rendermode InteractiveServer
@using CloudConfigurationHub.Application.Projects
@using ProjectDetailModel = CloudConfigurationHub.Application.Projects.ProjectDetail
@using Mediator
@inject ISender Sender
@inject ILogger<EnvironmentReleaseHistory> Logger
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["ReleaseHistory.PageTitle"]</PageTitle>

<section class="admin-page control-surface narrow-page">
    @if (isLoading) {
        <FluentCard Class="state-card">
            <FluentProgressRing />
            <p>@Texts["ProjectDetail.Loading"]</p>
        </FluentCard>
    }
    else if (project is null || environment is null) {
        <FluentCard Class="state-card">
            <h2>@Texts["ProjectDetail.NotFoundTitle"]</h2>
            <p>@Texts["ReleaseHistory.NotFoundDescription"]</p>
            <a class="primary-action" href="projects">@Texts["ProjectDetail.BackToProjects"]</a>
        </FluentCard>
    }
    else {
        <div class="admin-page-header command-hero">
            <div>
                <p class="eyebrow">@Texts["ReleaseHistory.Eyebrow"]</p>
                <h1>@Texts["ReleaseHistory.Title"]</h1>
                <p class="page-description">
                    @project.Name / <span class="text-code">@environment.Key</span>
                    <br />
                    @Texts["ReleaseHistory.Description"]
                </p>
            </div>
            <a class="secondary-action" href="@($"projects/{ProjectId}")">@Texts["ProjectDetail.BackToProject"]</a>
        </div>

        <FluentCard Class="detail-card command-card release-history-panel">
            <form class="interactive-form" @onsubmit:preventDefault="true">
                @if (!string.IsNullOrWhiteSpace(statusMessage)) {
                    <div class="success-banner" role="status">@statusMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(errorMessage)) {
                    <div class="error-banner" role="alert">@errorMessage</div>
                }

                <div class="section-heading">
                    <h2>@Texts["ReleaseHistory.History"]</h2>
                    <span class="status-pill">@ReleaseRows.Count</span>
                </div>

                @if (ReleaseRows.Count == 0) {
                    <div class="mini-empty">
                        <div class="orb-icon small violet" aria-hidden="true"></div>
                        <p class="muted-text">@Texts["ReleaseHistory.NoReleases"]</p>
                    </div>
                }
                else {
                    <div class="table-scroll">
                        <table class="detail-table release-history-table">
                            <thead>
                                <tr>
                                    <th>@Texts["ReleaseHistory.Version"]</th>
                                    <th>@Texts["ReleaseHistory.Note"]</th>
                                    <th>@Texts["ReleaseHistory.PublishedBy"]</th>
                                    <th>@Texts["ReleaseHistory.PublishedAt"]</th>
                                    <th>@Texts["Common.Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var release in ReleaseRows) {
                                    <tr>
                                        <td><code>@($"v{release.Version}")</code></td>
                                        <td>@release.Note</td>
                                        <td>@release.PublishedBy</td>
                                        <td>@release.PublishedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>
                                            <button class="secondary-action compact button-reset" type="button" disabled="@isRollingBack" @onclick="() => RollbackAsync(release)">
                                                @(isRollingBack && rollingBackReleaseId == release.Id ? Texts["ReleaseHistory.RollingBack"] : Texts["ReleaseHistory.Rollback"])
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </form>
        </FluentCard>
    }
</section>

@code {
    /// <summary>
    /// 当前项目 ID。
    /// </summary>
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>
    /// 当前查看发布历史的环境 ID。
    /// </summary>
    [Parameter]
    public Guid EnvironmentId { get; set; }

    /// <summary>
    /// 项目详情读取模型。
    /// </summary>
    private ProjectDetailModel? project;

    /// <summary>
    /// 当前发布历史所属环境。
    /// </summary>
    private EnvironmentSummary? environment;

    /// <summary>
    /// 当前环境发布历史行集合。
    /// </summary>
    private List<ConfigurationReleaseSummary> ReleaseRows { get; } = [];

    /// <summary>
    /// 指示页面是否正在加载项目详情。
    /// </summary>
    private bool isLoading = true;

    /// <summary>
    /// 指示回滚命令是否正在执行。
    /// </summary>
    private bool isRollingBack;

    /// <summary>
    /// 当前正在回滚的发布版本 ID。
    /// </summary>
    private Guid? rollingBackReleaseId;

    /// <summary>
    /// 成功回滚后展示的状态消息。
    /// </summary>
    private string? statusMessage;

    /// <summary>
    /// 回滚失败时展示的错误消息。
    /// </summary>
    private string? errorMessage;

    /// <summary>
    /// 读取项目详情并构建环境发布历史。
    /// </summary>
    protected override async Task OnInitializedAsync() {
        await LoadAsync();
    }

    /// <summary>
    /// 从读取模型刷新项目详情与当前环境发布历史。
    /// </summary>
    private async Task LoadAsync() {
        Logger.LogInformation(
            "管理端开始读取环境发布历史页面。ProjectId={ProjectId}, EnvironmentId={EnvironmentId}",
            ProjectId,
            EnvironmentId);
        project = await Sender.Send(new GetProjectDetailQuery(ProjectId), CancellationToken.None);
        environment = project?.Environments.SingleOrDefault(item => item.Id == EnvironmentId);
        ReleaseRows.Clear();
        if (project is not null && environment is not null) {
            ReleaseRows.AddRange(project.Releases
                .Where(item => item.EnvironmentId == EnvironmentId)
                .OrderByDescending(item => item.Version));
        }

        isLoading = false;
        Logger.LogInformation(
            "管理端环境发布历史页面读取完成。ProjectId={ProjectId}, EnvironmentId={EnvironmentId}, Found={Found}, ReleaseCount={ReleaseCount}",
            ProjectId,
            EnvironmentId,
            project is not null && environment is not null,
            ReleaseRows.Count);
    }

    /// <summary>
    /// 从指定历史版本生成新的发布版本，实现回滚。
    /// </summary>
    /// <param name="release">作为回滚源的历史发布版本。</param>
    private async Task RollbackAsync(ConfigurationReleaseSummary release) {
        if (environment is null) {
            return;
        }

        isRollingBack = true;
        rollingBackReleaseId = release.Id;
        errorMessage = null;
        statusMessage = null;
        try {
            var result = await Sender.Send(
                new RollbackEnvironmentCommand(
                    ProjectId,
                    EnvironmentId,
                    release.Id,
                    string.Format(Texts["ReleaseHistory.RollbackNote"], release.Version),
                    "admin"),
                CancellationToken.None);
            statusMessage = string.Format(Texts["ReleaseHistory.RollbackSucceeded"], result.Version);
            Logger.LogInformation(
                "管理端已提交环境配置回滚。ProjectId={ProjectId}, EnvironmentId={EnvironmentId}, SourceReleaseId={SourceReleaseId}, Version={Version}",
                ProjectId,
                EnvironmentId,
                release.Id,
                result.Version);
            await LoadAsync();
        }
        catch (Exception exception) {
            errorMessage = exception.Message;
            Logger.LogWarning(
                exception,
                "管理端环境配置回滚失败。ProjectId={ProjectId}, EnvironmentId={EnvironmentId}, SourceReleaseId={SourceReleaseId}",
                ProjectId,
                EnvironmentId,
                release.Id);
        }
        finally {
            isRollingBack = false;
            rollingBackReleaseId = null;
        }
    }
}
