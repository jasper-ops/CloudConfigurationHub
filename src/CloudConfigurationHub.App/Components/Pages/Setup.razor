@page "/setup"
@rendermode InteractiveServer
@layout PlainLayout
@attribute [AllowAnonymous]
@inject ISetupStateReader SetupStateReader
@inject ISetupAdministratorService SetupAdministratorService
@inject NavigationManager NavigationManager
@inject ILogger<Setup> Logger
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["Setup.PageTitle"]</PageTitle>

<section class="cch-setup-shell">
    <aside class="cch-setup-aside">
        <div class="cch-setup-brand">
            <span class="cch-brand-mark light" aria-hidden="true"></span>
            <strong>配置中心</strong>
        </div>
        <div class="cch-setup-copy">
            <h1>欢迎使用配置中心</h1>
            <p>一个简约、易用的多环境应用配置管理平台。</p>
            <ul>
                <li>按项目组织配置</li>
                <li>灵活自定义环境</li>
                <li>双视角管理配置值</li>
            </ul>
        </div>
        <p class="cch-version">config-center · v1.0</p>
    </aside>

    <main class="cch-setup-main">
        <div class="cch-setup-pref"><ThemeSwitcher /></div>
        <div class="cch-setup-form">
            <div class="cch-step"><span>01</span>账号信息</div>
            <h2>创建管理员账号</h2>
            <p>这是系统首次启动，请先创建一个管理员账号以继续。</p>

        @if (!string.IsNullOrWhiteSpace(errorMessage)) {
            <div class="cch-error" role="alert">@errorMessage</div>
        }

        @if (isLoading) {
            <FluentProgressRing />
        }
        else {
            <form class="cch-form-stack" @onsubmit:preventDefault="true">
                <label class="cch-field">
                    <span>@Texts["Setup.EmailLabel"]</span>
                    <input class="cch-input" autocomplete="username" name="setup-email" type="email" @bind="FormModel.Email" @bind:event="oninput" />
                </label>

                <label class="cch-field">
                    <span>@Texts["Setup.PasswordLabel"]</span>
                    <input class="cch-input" autocomplete="new-password" name="setup-password" type="password" @bind="FormModel.Password" @bind:event="oninput" />
                </label>

                <label class="cch-field">
                    <span>@Texts["Setup.ConfirmPasswordLabel"]</span>
                    <input class="cch-input" autocomplete="new-password" name="setup-confirm-password" type="password" @bind="FormModel.ConfirmPassword" @bind:event="oninput" />
                </label>

                <div>
                    <button class="cch-button large full" type="button" disabled="@isSubmitting" @onclick="CreateAdministratorAsync">
                        @(isSubmitting ? Texts["Setup.Creating"] : Texts["Setup.Submit"])
                    </button>
                </div>
            </form>
        }
        </div>
    </main>
</section>

@code {
    /// <summary>
    /// 启动向导表单模型。
    /// </summary>
    private SetupFormModel FormModel { get; } = new();

    /// <summary>
    /// 页面是否正在读取启动状态。
    /// </summary>
    private bool isLoading = true;

    /// <summary>
    /// 表单是否正在提交。
    /// </summary>
    private bool isSubmitting;

    /// <summary>
    /// 页面级错误消息。
    /// </summary>
    private string? errorMessage;

    /// <summary>
    /// 初始化页面时检查系统是否已经完成首次启动配置。
    /// </summary>
    protected override async Task OnInitializedAsync() {
        var completed = await SetupStateReader.IsSetupCompletedAsync(CancellationToken.None);
        if (completed) {
            Logger.LogInformation("访问启动向导时系统已经初始化，重定向到登录页。");
            NavigationManager.NavigateTo("Account/Login", forceLoad: true);
            return;
        }

        isLoading = false;
    }

    /// <summary>
    /// 创建初始管理员账号。
    /// </summary>
    private async Task CreateAdministratorAsync() {
        if (isSubmitting) {
            return;
        }

        errorMessage = null;
        if (string.IsNullOrWhiteSpace(FormModel.Email)
            || string.IsNullOrWhiteSpace(FormModel.Password)
            || string.IsNullOrWhiteSpace(FormModel.ConfirmPassword)) {
            errorMessage = Texts["Setup.ValidationRequired"];
            return;
        }

        if (!string.Equals(FormModel.Password, FormModel.ConfirmPassword, StringComparison.Ordinal)) {
            errorMessage = Texts["Setup.PasswordMismatch"];
            return;
        }

        isSubmitting = true;
        try {
            var result = await SetupAdministratorService.CreateInitialAdministratorAsync(
                new SetupAdministratorRequest(FormModel.Email, FormModel.Password),
                CancellationToken.None);
            if (!result.Succeeded) {
                errorMessage = result.ErrorMessage;
                return;
            }

            Logger.LogInformation("Setup.AdminCreated Email={Email}", FormModel.Email);
            NavigationManager.NavigateTo("Account/Login", forceLoad: true);
        }
        finally {
            isSubmitting = false;
        }
    }

    /// <summary>
    /// 启动向导表单字段。
    /// </summary>
    public sealed class SetupFormModel {
        /// <summary>
        /// 初始管理员邮箱。
        /// </summary>
        public string Email { get; set; } = string.Empty;

        /// <summary>
        /// 初始管理员密码。
        /// </summary>
        public string Password { get; set; } = string.Empty;

        /// <summary>
        /// 初始管理员确认密码。
        /// </summary>
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
