@page "/projects/{ProjectId:guid}/configurations/new"
@rendermode InteractiveServer
@using CloudConfigurationHub.Application.Projects
@using Mediator
@inject ISender Sender
@inject NavigationManager NavigationManager
@inject ILogger<ConfigurationCreate> Logger
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["ConfigurationCreate.PageTitle"]</PageTitle>

<section class="admin-page control-surface">
    <div class="admin-page-header command-hero">
        <div>
            <p class="eyebrow">@Texts["ProjectDetail.Configurations"]</p>
            <h1>@Texts["ConfigurationCreate.Title"]</h1>
            <p class="page-description">@Texts["ConfigurationCreate.Description"]</p>
        </div>
        <a class="secondary-action" href="@($"projects/{ProjectId}")">@Texts["ProjectDetail.BackToProject"]</a>
    </div>

    <div class="create-layout">
        <FluentCard Class="form-card command-card">
            <form class="interactive-form" @onsubmit:preventDefault="true">
                @if (!string.IsNullOrWhiteSpace(errorMessage)) {
                    <div class="error-banner" role="alert">@errorMessage</div>
                }

                <div class="form-grid">
                    <label>
                        <span>@Texts["ConfigurationCreate.GroupLabel"]</span>
                        <input class="text-input code-input" name="FormModel.Group" @bind="FormModel.Group" @bind:event="oninput" />
                        <small>@Texts["ConfigurationCreate.GroupHelp"]</small>
                    </label>
                    <label>
                        <span>@Texts["ConfigurationCreate.KeyLabel"]</span>
                        <input class="text-input code-input" name="FormModel.Key" @bind="FormModel.Key" @bind:event="oninput" />
                        <small>@Texts["ConfigurationCreate.KeyHelp"]</small>
                    </label>
                    <label class="toggle-field">
                        <input type="checkbox" name="FormModel.IsSensitive" @bind="FormModel.IsSensitive" />
                        <span>@Texts["ConfigurationCreate.IsSensitiveLabel"]</span>
                        <small>@Texts["ConfigurationCreate.IsSensitiveHelp"]</small>
                    </label>
                </div>

                <div class="form-actions">
                    <button class="primary-action button-reset" type="button" disabled="@isSaving" @onclick="CreateConfigurationAsync">
                        @(isSaving ? Texts["ConfigurationCreate.Saving"] : Texts["ConfigurationCreate.Submit"])
                    </button>
                </div>
            </form>
        </FluentCard>

        <aside class="insight-panel" aria-label="@Texts["ConfigurationCreate.GuideTitle"]">
            <div class="insight-card">
                <span>01</span>
                <strong>@Texts["ConfigurationCreate.GuideKey"]</strong>
                <p>@Texts["ConfigurationCreate.GuideKeyDescription"]</p>
            </div>
            <div class="insight-card">
                <span>02</span>
                <strong>@Texts["ConfigurationCreate.GuideSensitive"]</strong>
                <p>@Texts["ConfigurationCreate.GuideSensitiveDescription"]</p>
            </div>
        </aside>
    </div>
</section>

@code {
    /// <summary>
    /// 当前项目 ID，配置定义会被添加到此项目聚合下。
    /// </summary>
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>
    /// 添加配置定义表单模型。
    /// </summary>
    private ConfigurationCreateFormModel FormModel { get; } = new();

    /// <summary>
    /// 指示添加配置命令是否正在提交，用于避免重复点击。
    /// </summary>
    private bool isSaving;

    /// <summary>
    /// 添加失败或表单校验失败时展示给管理员的错误消息。
    /// </summary>
    private string? errorMessage;

    /// <summary>
    /// 校验并提交添加配置定义命令，成功后回到项目详情页。
    /// </summary>
    private async Task CreateConfigurationAsync() {
        if (string.IsNullOrWhiteSpace(FormModel.Group) || string.IsNullOrWhiteSpace(FormModel.Key)) {
            errorMessage = Texts["ConfigurationCreate.ValidationRequired"];
            Logger.LogWarning(
                "管理端添加配置定义表单校验失败。ProjectId={ProjectId}, HasGroup={HasGroup}, HasKey={HasKey}, IsSensitive={IsSensitive}",
                ProjectId,
                !string.IsNullOrWhiteSpace(FormModel.Group),
                !string.IsNullOrWhiteSpace(FormModel.Key),
                FormModel.IsSensitive);
            return;
        }

        isSaving = true;
        errorMessage = null;
        try {
            var configuration = await Sender.Send(
                new AddConfigurationCommand(ProjectId, FormModel.Group, FormModel.Key, FormModel.IsSensitive),
                CancellationToken.None);
            Logger.LogInformation(
                "管理端已添加配置定义并准备返回项目详情页。ProjectId={ProjectId}, ConfigurationId={ConfigurationId}, Group={Group}, Key={Key}, IsSensitive={IsSensitive}",
                ProjectId,
                configuration.Id,
                configuration.Group,
                configuration.Key,
                configuration.IsSensitive);
            NavigationManager.NavigateTo($"projects/{ProjectId}");
        }
        catch (Exception exception) {
            errorMessage = exception.Message;
            Logger.LogWarning(
                exception,
                "管理端添加配置定义失败。ProjectId={ProjectId}, Group={Group}, Key={Key}, IsSensitive={IsSensitive}",
                ProjectId,
                FormModel.Group,
                FormModel.Key,
                FormModel.IsSensitive);
        }
        finally {
            isSaving = false;
        }
    }

    /// <summary>
    /// 添加配置定义页面的表单字段集合。
    /// </summary>
    public sealed class ConfigurationCreateFormModel {
        /// <summary>
        /// 配置分组名称，用于生成 .NET 配置 Key 的第一段。
        /// </summary>
        public string Group { get; set; } = string.Empty;

        /// <summary>
        /// 配置项 Key，用于生成 .NET 配置 Key 的第二段。
        /// </summary>
        public string Key { get; set; } = string.Empty;

        /// <summary>
        /// 是否按敏感配置处理；敏感值后续保存草稿时会加密存储，查询时脱敏显示。
        /// </summary>
        public bool IsSensitive { get; set; }
    }
}
