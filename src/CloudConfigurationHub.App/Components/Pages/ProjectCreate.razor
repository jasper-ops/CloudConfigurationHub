@page "/projects/new"
@rendermode InteractiveServer
@using CloudConfigurationHub.Application.Projects
@using Mediator
@inject ISender Sender
@inject NavigationManager NavigationManager
@inject ILogger<ProjectCreate> Logger
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["ProjectCreate.PageTitle"]</PageTitle>

<section class="admin-page control-surface">
    <div class="admin-page-header command-hero">
        <div>
            <p class="eyebrow">@Texts["Projects.Eyebrow"]</p>
            <h1>@Texts["ProjectCreate.Title"]</h1>
            <p class="page-description">@Texts["ProjectCreate.Description"]</p>
        </div>
        <a class="secondary-action" href="projects">@Texts["ProjectDetail.BackToProjects"]</a>
    </div>

    <div class="create-layout">
        <FluentCard Class="form-card command-card">
            <form class="interactive-form" @onsubmit:preventDefault="true">
                @if (!string.IsNullOrWhiteSpace(errorMessage)) {
                    <div class="error-banner" role="alert">@errorMessage</div>
                }

                <div class="form-grid">
                    <label>
                        <span>@Texts["ProjectCreate.NameLabel"]</span>
                        <input class="text-input" name="FormModel.Name" @bind="FormModel.Name" @bind:event="oninput" />
                    </label>
                    <label>
                        <span>@Texts["ProjectCreate.KeyLabel"]</span>
                        <input class="text-input code-input" name="FormModel.Key" @bind="FormModel.Key" @bind:event="oninput" />
                        <small>@Texts["ProjectCreate.KeyHelp"]</small>
                    </label>
                </div>

                <div class="form-actions">
                    <button class="primary-action button-reset" type="button" disabled="@isSaving" @onclick="CreateProjectAsync">
                        @(isSaving ? Texts["ProjectCreate.Saving"] : Texts["ProjectCreate.Submit"])
                    </button>
                </div>
            </form>
        </FluentCard>

        <aside class="insight-panel" aria-label="@Texts["ProjectCreate.GuideTitle"]">
            <div class="insight-card">
                <span>01</span>
                <strong>@Texts["ProjectCreate.GuideProject"]</strong>
                <p>@Texts["ProjectCreate.GuideProjectDescription"]</p>
            </div>
            <div class="insight-card">
                <span>02</span>
                <strong>@Texts["ProjectCreate.GuideEnvironment"]</strong>
                <p>@Texts["ProjectCreate.GuideEnvironmentDescription"]</p>
            </div>
            <div class="insight-card">
                <span>03</span>
                <strong>@Texts["ProjectCreate.GuideRelease"]</strong>
                <p>@Texts["ProjectCreate.GuideReleaseDescription"]</p>
            </div>
        </aside>
    </div>
</section>

@code {
    /// <summary>
    /// 创建项目表单模型。
    /// </summary>
    private ProjectCreateFormModel FormModel { get; } = new();

    /// <summary>
    /// 指示创建命令是否正在提交，用于禁用重复提交。
    /// </summary>
    private bool isSaving;

    /// <summary>
    /// 创建失败时向用户展示的错误消息。
    /// </summary>
    private string? errorMessage;

    /// <summary>
    /// 处理创建项目表单提交，成功后跳转至项目详情页。
    /// </summary>
    private async Task CreateProjectAsync() {
        if (string.IsNullOrWhiteSpace(FormModel.Name) || string.IsNullOrWhiteSpace(FormModel.Key)) {
            errorMessage = Texts["ProjectCreate.ValidationRequired"];
            Logger.LogWarning(
                "管理端创建项目表单校验失败。HasName={HasName}, HasKey={HasKey}",
                !string.IsNullOrWhiteSpace(FormModel.Name),
                !string.IsNullOrWhiteSpace(FormModel.Key));
            return;
        }

        isSaving = true;
        errorMessage = null;
        try {
            var project = await Sender.Send(
                new CreateProjectCommand(FormModel.Name, FormModel.Key),
                CancellationToken.None);
            Logger.LogInformation(
                "管理端已创建项目并准备跳转详情页。ProjectId={ProjectId}, ProjectKey={ProjectKey}",
                project.Id,
                project.Key);
            NavigationManager.NavigateTo($"projects/{project.Id}");
        }
        catch (Exception exception) {
            errorMessage = exception.Message;
            Logger.LogWarning(
                exception,
                "管理端创建项目失败。ProjectName={ProjectName}, ProjectKey={ProjectKey}",
                FormModel.Name,
                FormModel.Key);
        }
        finally {
            isSaving = false;
        }
    }

    /// <summary>
    /// 创建项目页面的表单字段集合。
    /// </summary>
    public sealed class ProjectCreateFormModel {
        /// <summary>
        /// 项目显示名称，用于管理端列表与详情页展示。
        /// </summary>
        public string Name { get; set; } = string.Empty;

        /// <summary>
        /// 项目唯一 Key，用于 SDK 读取和管理端识别项目边界。
        /// </summary>
        public string Key { get; set; } = string.Empty;
    }
}
