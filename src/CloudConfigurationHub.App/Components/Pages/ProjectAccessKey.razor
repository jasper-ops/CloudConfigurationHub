@page "/projects/{ProjectId:guid}/access-key"
@rendermode InteractiveServer
@using CloudConfigurationHub.Application.Projects
@using ProjectDetailModel = CloudConfigurationHub.Application.Projects.ProjectDetail
@using Mediator
@inject ISender Sender
@inject ILogger<ProjectAccessKey> Logger
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["AccessKey.PageTitle"]</PageTitle>

<section class="admin-page control-surface narrow-page">
    @if (isLoading) {
        <FluentCard Class="state-card">
            <FluentProgressRing />
            <p>@Texts["ProjectDetail.Loading"]</p>
        </FluentCard>
    }
    else if (project is null) {
        <FluentCard Class="state-card">
            <h2>@Texts["ProjectDetail.NotFoundTitle"]</h2>
            <p>@Texts["ProjectDetail.NotFoundDescription"]</p>
            <a class="primary-action" href="projects">@Texts["ProjectDetail.BackToProjects"]</a>
        </FluentCard>
    }
    else {
        <div class="admin-page-header command-hero">
            <div>
                <p class="eyebrow">@Texts["AccessKey.Eyebrow"]</p>
                <h1>@Texts["AccessKey.Title"]</h1>
                <p class="page-description">
                    @Texts["AccessKey.Description"]
                    <br />
                    <span class="text-code">@project.Key</span>
                </p>
            </div>
            <a class="secondary-action" href="@($"projects/{ProjectId}")">@Texts["ProjectDetail.BackToProject"]</a>
        </div>

        <FluentCard Class="form-card command-card access-key-panel">
            <form class="interactive-form" @onsubmit:preventDefault="true">
                @if (!string.IsNullOrWhiteSpace(errorMessage)) {
                    <div class="error-banner" role="alert">@errorMessage</div>
                }

                <div class="warning-banner" role="note">
                    @Texts["AccessKey.Warning"]
                </div>

                @if (!string.IsNullOrWhiteSpace(GeneratedAccessKey)) {
                    <label class="generated-secret-block">
                        <span>@Texts["AccessKey.GeneratedLabel"]</span>
                        <input class="text-input code-input" readonly value="@GeneratedAccessKey" />
                        <small>@Texts["AccessKey.GeneratedHelp"]</small>
                    </label>
                }

                <div class="form-actions">
                    <button class="primary-action button-reset" type="button" disabled="@isRotating" @onclick="RotateAsync">
                        @(isRotating ? Texts["AccessKey.Rotating"] : Texts["AccessKey.Rotate"])
                    </button>
                </div>
            </form>
        </FluentCard>
    }
</section>

@code {
    /// <summary>
    /// 当前项目 ID。
    /// </summary>
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>
    /// 当前项目详情读取模型。
    /// </summary>
    private ProjectDetailModel? project;

    /// <summary>
    /// 只在轮换成功后展示一次的 Access Key 明文。
    /// </summary>
    private string? GeneratedAccessKey { get; set; }

    /// <summary>
    /// 指示页面是否正在加载项目详情。
    /// </summary>
    private bool isLoading = true;

    /// <summary>
    /// 指示密钥轮换命令是否正在执行。
    /// </summary>
    private bool isRotating;

    /// <summary>
    /// 轮换失败时展示的错误消息。
    /// </summary>
    private string? errorMessage;

    /// <summary>
    /// 读取项目详情并记录页面访问日志。
    /// </summary>
    protected override async Task OnInitializedAsync() {
        Logger.LogInformation("管理端开始读取项目访问密钥页面。ProjectId={ProjectId}", ProjectId);
        project = await Sender.Send(new GetProjectDetailQuery(ProjectId), CancellationToken.None);
        isLoading = false;
        Logger.LogInformation(
            "管理端项目访问密钥页面读取完成。ProjectId={ProjectId}, Found={Found}",
            ProjectId,
            project is not null);
    }

    /// <summary>
    /// 轮换项目级只读 Access Key，并将明文仅展示在当前页面状态中。
    /// </summary>
    private async Task RotateAsync() {
        if (project is null) {
            return;
        }

        isRotating = true;
        errorMessage = null;
        GeneratedAccessKey = null;
        try {
            var result = await Sender.Send(
                new RotateProjectAccessKeyCommand(ProjectId, "admin"),
                CancellationToken.None);
            GeneratedAccessKey = result.AccessKey;
            Logger.LogInformation(
                "管理端已轮换项目访问密钥。ProjectId={ProjectId}, ProjectKey={ProjectKey}",
                result.ProjectId,
                result.ProjectKey);
        }
        catch (Exception exception) {
            errorMessage = exception.Message;
            Logger.LogWarning(
                exception,
                "管理端轮换项目访问密钥失败。ProjectId={ProjectId}",
                ProjectId);
        }
        finally {
            isRotating = false;
        }
    }
}
