@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["Error.PageTitle"]</PageTitle>

<h1 class="text-danger">@Texts["Error.Title"]</h1>
<h2 class="text-danger">@Texts["Error.Description"]</h2>

@if (ShowRequestId) {
    <p>
        <strong>@Texts["Error.RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Texts["Error.DevelopmentMode"]</h3>
<p>
    @Texts["Error.DevelopmentHint"]
</p>
<p>
    @Texts["Error.DevelopmentWarning"]
</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
