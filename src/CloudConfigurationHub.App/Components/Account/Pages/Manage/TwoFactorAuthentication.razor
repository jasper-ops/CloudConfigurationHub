@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using CloudConfigurationHub.App.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["Identity.Manage.TwoFactorTitle"]</PageTitle>

<StatusMessage />
<h3>@Texts["Identity.Manage.TwoFactorTitle"]</h3>
@if (canTrack)
{
    if (is2faEnabled)
    {
        if (recoveryCodesLeft == 0)
        {
            <div class="alert alert-danger">
                <strong>@Texts["Identity.Manage.NoRecoveryCodes"]</strong>
                <p>@Texts["Identity.Manage.GenerateRecoveryCodesRequiredPrefix"] <a href="Account/Manage/GenerateRecoveryCodes">@Texts["Identity.Manage.GenerateRecoveryCodesLink"]</a> @Texts["Identity.Manage.GenerateRecoveryCodesRequiredSuffix"]</p>
            </div>
        }
        else if (recoveryCodesLeft == 1)
        {
            <div class="alert alert-danger">
                <strong>@Texts["Identity.Manage.OneRecoveryCodeLeft"]</strong>
                <p>@Texts["Identity.Manage.CanGenerateRecoveryCodesPrefix"] <a href="Account/Manage/GenerateRecoveryCodes">@Texts["Identity.Manage.GenerateRecoveryCodesLink"]</a>.</p>
            </div>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <div class="alert alert-warning">
                <strong>@Texts["Identity.Manage.RecoveryCodesLeft", recoveryCodesLeft]</strong>
                <p>@Texts["Identity.Manage.ShouldGenerateRecoveryCodesPrefix"] <a href="Account/Manage/GenerateRecoveryCodes">@Texts["Identity.Manage.GenerateRecoveryCodesLink"]</a>.</p>
            </div>
        }

        if (isMachineRemembered)
        {
            <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">@Texts["Identity.Manage.ForgetBrowser"]</button>
            </form>
        }

        <a href="Account/Manage/Disable2fa" class="btn btn-primary">@Texts["Identity.Manage.Disable2Fa"]</a>
        <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-primary">@Texts["Identity.Manage.ResetRecoveryCodes"]</a>
    }

    <h4>@Texts["Identity.Manage.AuthenticatorApp"]</h4>
    @if (!hasAuthenticator)
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">@Texts["Identity.Manage.AddAuthenticatorApp"]</a>
    }
    else
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">@Texts["Identity.Manage.SetupAuthenticatorApp"]</a>
        <a href="Account/Manage/ResetAuthenticator" class="btn btn-primary">@Texts["Identity.Manage.ResetAuthenticatorApp"]</a>
    }
}
else
{
    <div class="alert alert-danger">
        <strong>@Texts["Identity.Manage.TrackingNotAccepted"]</strong>
        <p>@Texts["Identity.Manage.TrackingRequiredForTwoFactor"]</p>
    </div>
}

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null) {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync() {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            Texts["Identity.Manage.BrowserForgotten"],
            HttpContext);
    }
}
