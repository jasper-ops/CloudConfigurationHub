@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using CloudConfigurationHub.App.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["Identity.Manage.PersonalDataTitle"]</PageTitle>

<StatusMessage />

<div class="demo-account-section">
    <div class="demo-account-section-head">
        <h2>@Texts["Identity.Manage.PersonalDataTitle"]</h2>
        <p>@Texts["Identity.Manage.PersonalDataDescription"]</p>
    </div>
    <p class="demo-account-warning">@Texts["Identity.Manage.PersonalDataDeleteWarning"]</p>
    <div class="demo-account-actions">
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="demo-button" type="submit">@Texts["Identity.Download"]</button>
        </form>
        <a href="Account/Manage/DeletePersonalData" class="demo-button danger">@Texts["Identity.Delete"]</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null) {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
