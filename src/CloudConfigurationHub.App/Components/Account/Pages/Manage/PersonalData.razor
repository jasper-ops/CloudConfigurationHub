@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using CloudConfigurationHub.App.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["Identity.Manage.PersonalDataTitle"]</PageTitle>

<StatusMessage />
<h3>@Texts["Identity.Manage.PersonalDataTitle"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>@Texts["Identity.Manage.PersonalDataDescription"]</p>
        <p>
            <strong>@Texts["Identity.Manage.PersonalDataDeleteWarning"]</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">@Texts["Identity.Download"]</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@Texts["Identity.Delete"]</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null) {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
