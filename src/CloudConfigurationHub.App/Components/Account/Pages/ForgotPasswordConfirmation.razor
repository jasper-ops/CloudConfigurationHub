@page "/Account/ForgotPasswordConfirmation"

@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["Identity.ForgotPasswordConfirmation.Title"]</PageTitle>

<section class="cch-login-shell">
    <header class="cch-login-header">
        <div class="cch-setup-brand">
            <span class="cch-brand-mark" aria-hidden="true"></span>
            <strong>配置中心</strong>
        </div>
        <ThemeSwitcher />
    </header>

    <main class="cch-login-main">
        <section class="cch-login-card">
            <div class="cch-login-title">
                <h1>@Texts["Identity.ForgotPasswordConfirmation.Title"]</h1>
                <p role="alert">@Texts["Identity.ForgotPasswordConfirmation.Description"]</p>
            </div>

            <div class="cch-login-links">
                <a href="Account/Login">@Texts["Identity.Login.Title"]</a>
            </div>
        </section>
    </main>
</section>
