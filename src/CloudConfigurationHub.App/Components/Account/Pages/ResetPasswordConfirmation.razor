@page "/Account/ResetPasswordConfirmation"

@inject IStringLocalizer<AppText> Texts

<PageTitle>@Texts["Identity.ResetPasswordConfirmation.Title"]</PageTitle>

<h1>@Texts["Identity.ResetPasswordConfirmation.Title"]</h1>
<p role="alert">
    @Texts["Identity.ResetPasswordConfirmation.Description"]
    <a href="Account/Login">@Texts["Identity.ResetPasswordConfirmation.LoginLink"]</a>.
</p>
