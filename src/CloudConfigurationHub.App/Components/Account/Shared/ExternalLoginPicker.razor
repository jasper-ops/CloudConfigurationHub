@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using CloudConfigurationHub.App.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AppText> Texts

@if (externalLogins.Length == 0)
{
    <div>
        <p>
            @Texts["Identity.External.NoneConfigured"]
            <a href="https://go.microsoft.com/fwlink/?LinkID=532715">@Texts["Identity.External.SetupArticle"]</a>.
        </p>
    </div>
}
else
{
    <form class="form-horizontal" action="Account/PerformExternalLogin" method="post">
        <div>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <p>
                @foreach (var provider in externalLogins)
                {
                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="@Texts["Identity.External.ProviderTitle", provider.DisplayName ?? provider.Name]">@provider.DisplayName</button>
                }
            </p>
        </div>
    </form>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync() {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
