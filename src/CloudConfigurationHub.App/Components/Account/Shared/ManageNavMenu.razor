@using Microsoft.AspNetCore.Identity
@using CloudConfigurationHub.App.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IStringLocalizer<AppText> Texts

<nav class="demo-account-nav" aria-label="@Texts["Identity.Manage.AccountSettings"]">
    <NavLink class="demo-account-nav-link" href="Account/Manage" Match="NavLinkMatch.All">@Texts["Identity.Manage.Profile"]</NavLink>
    <NavLink class="demo-account-nav-link" href="Account/Manage/Email">@Texts["Identity.Email"]</NavLink>
    <NavLink class="demo-account-nav-link" href="Account/Manage/ChangePassword">@Texts["Identity.Password"]</NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="demo-account-nav-link" href="Account/Manage/ExternalLogins">@Texts["Identity.Manage.ExternalLogins"]</NavLink>
    }
    <NavLink class="demo-account-nav-link" href="Account/Manage/TwoFactorAuthentication">@Texts["Identity.Manage.TwoFactor"]</NavLink>
    <NavLink class="demo-account-nav-link" href="Account/Manage/Passkeys">@Texts["Identity.Manage.Passkeys"]</NavLink>
    <NavLink class="demo-account-nav-link" href="Account/Manage/PersonalData">@Texts["Identity.Manage.PersonalData"]</NavLink>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync() {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
