@inherits LayoutComponentBase
@layout CloudConfigurationHub.App.Components.Layout.MainLayout
@inject IStringLocalizer<AppText> Texts

<section class="cch-account-workbench">
    <header class="cch-account-head">
        <div>
            <h1>@Texts["Identity.Manage.AccountTitle"]</h1>
            <p>@Texts["Identity.Manage.AccountSettings"]</p>
        </div>
    </header>

    <div class="cch-account-grid">
        <aside class="cch-account-side">
            <ManageNavMenu />
        </aside>
        <section class="cch-account-panel">
            @Body
        </section>
    </div>
</section>
