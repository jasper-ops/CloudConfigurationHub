@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager

<details class="language-switcher" aria-label="@AriaLabel">
    <summary title="@CurrentLanguage.NativeLabel">
        <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="m5 8 6 6" />
            <path d="m4 14 6-6 2-3" />
            <path d="M2 5h12" />
            <path d="M7 2h1" />
            <path d="m22 22-5-10-5 10" />
            <path d="M14 18h6" />
        </svg>
        <span>@CurrentLanguage.ShortLabel</span>
    </summary>
    <div class="language-menu">
        @foreach (var language in Languages) {
            <a class="@GetLinkClass(language.Culture)" href="@BuildCultureUrl(language.Culture)" data-enhance-nav="false">
                <span>@language.NativeLabel</span>
                <small>@language.ShortLabel</small>
            </a>
        }
    </div>
</details>

@code {
    /// <summary>
    /// 语言切换器的无障碍标签。
    /// </summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Language";

    private string CurrentCultureName => ResolveCultureName();
    private LanguageOption CurrentLanguage => Languages.FirstOrDefault(language =>
        string.Equals(language.Culture, CurrentCultureName, StringComparison.OrdinalIgnoreCase))
        ?? Languages[0];

    private static readonly LanguageOption[] Languages = [
        new("zh-CN", "中文", "ZH"),
        new("en-US", "English", "EN"),
        new("ja-JP", "日本語", "JA"),
        new("ko-KR", "한국어", "KO"),
        new("es-ES", "Español", "ES")
    ];

    private string BuildCultureUrl(string culture) {
        return NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> {
            ["culture"] = culture,
            ["ui-culture"] = culture
        });
    }

    private string GetLinkClass(string culture) {
        return string.Equals(CurrentCultureName, culture, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }

    private string ResolveCultureName() {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("ui-culture", out var uiCulture) && !string.IsNullOrWhiteSpace(uiCulture)) {
            return uiCulture.ToString();
        }

        if (query.TryGetValue("culture", out var culture) && !string.IsNullOrWhiteSpace(culture)) {
            return culture.ToString();
        }

        return CultureInfo.CurrentUICulture.Name;
    }

    private sealed record LanguageOption(string Culture, string NativeLabel, string ShortLabel);
}
