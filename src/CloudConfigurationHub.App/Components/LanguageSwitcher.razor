@using System.Globalization
@inject NavigationManager NavigationManager

<div class="language-switcher" aria-label="@AriaLabel">
    <a class="@GetLinkClass("zh-CN")" href="@BuildCultureUrl("zh-CN")" data-enhance-nav="false">中文</a>
    <span aria-hidden="true">/</span>
    <a class="@GetLinkClass("en-US")" href="@BuildCultureUrl("en-US")" data-enhance-nav="false">EN</a>
</div>

@code {
    /// <summary>
    /// 语言切换器的无障碍标签。
    /// </summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Language";

    private string CurrentCultureName => CultureInfo.CurrentUICulture.Name;

    private string BuildCultureUrl(string culture) {
        return NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> {
            ["culture"] = culture,
            ["ui-culture"] = culture
        });
    }

    private string GetLinkClass(string culture) {
        return string.Equals(CurrentCultureName, culture, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }
}
