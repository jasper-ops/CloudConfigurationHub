@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using CloudConfigurationHub.Application.Projects
@using Mediator
@inject ISender Sender
@inject NavigationManager NavigationManager

@if (isLoading) {
    <div class="cch-empty">正在加载...</div>
}
else if (InitialView == "configs") {
    <div class="cch-workbench cch-configurations-workbench">
        <div class="cch-page-head">
            <div>
                <h1>@L("配置管理", "Configs")</h1>
                <p>@L("选择项目", "Select project")</p>
            </div>
            <div class="cch-combobox" @onfocusout="CloseProjectPickerSoon">
                <input class="cch-input" value="@ProjectPickerText" placeholder="@L("搜索项目", "Search projects")" @onfocus="OpenProjectPicker" @oninput="OnProjectPickerInput" />
                @if (projectPickerOpen) {
                    <div class="cch-combobox-menu">
                        @if (FilteredProjectOptions().Count == 0) {
                            <div class="cch-combobox-empty">@L("暂无数据", "No data")</div>
                        }
                        @foreach (var item in FilteredProjectOptions()) {
                            <button class="@(selectedProjectId == item.Id ? "active" : null)" type="button" @onclick="() => PickProject(item.Id)">@item.Name</button>
                        }
                    </div>
                }
            </div>
        </div>

        @if (SelectedProject is null) {
            <div class="cch-empty">@L("请先在“项目管理”中创建一个项目", "Create a project first")</div>
        }
        else {
            var project = SelectedProject;
            <div class="cch-mode-row">
                <div class="cch-segmented">
                    <button class="@(configMode == "env" ? "active" : null)" type="button" @onclick='() => configMode = "env"'>
                        <svg aria-hidden="true" viewBox="0 0 24 24"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><path d="M6 6h.01"/><path d="M6 18h.01"/></svg>
                        @L("按环境", "By env")
                    </button>
                    <button class="@(configMode == "config" ? "active" : null)" type="button" @onclick='() => configMode = "config"'>
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.5-9.17 4.17a2 2 0 0 1-1.66 0L2 12.5"/><path d="m22 17.5-9.17 4.17a2 2 0 0 1-1.66 0L2 17.5"/></svg>
                        @L("按配置", "By config")
                    </button>
                </div>
                <p>@(configMode == "env" ? L("选择一个环境，管理该环境下的全部配置", "Select one environment and manage all configs") : L("选择一个配置项，管理它在所有环境下的值", "Select one config and manage values across environments"))</p>
            </div>

            @if (project.Environments.Count == 0) {
                <div class="cch-empty">@L("该项目暂无环境，请先在项目设置中添加环境", "This project has no environments")</div>
            }
            else {
                <div class="cch-release-toolbar">
                    <div class="cch-env-tabs">
                        @foreach (var env in project.Environments) {
                            <button class="@(selectedEnvironmentId == env.Id ? "active" : null)" type="button" @onclick="() => selectedEnvironmentId = env.Id">
                                <i style="@DotStyle(env.Key)"></i>@env.Name
                            </button>
                        }
                    </div>
                    <div class="cch-release-actions">
                        <button class="cch-button outline" type="button" @onclick="OpenNewEnvironment">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                            @L("新增环境", "New env")
                        </button>
                        <button class="cch-button outline" type="button" disabled="@(selectedEnvironmentId is null)" @onclick="OpenPublishPanel">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="m16 6-4-4-4 4"/><path d="M12 2v14"/></svg>
                            @L("发布", "Publish")
                        </button>
                        <button class="cch-button outline" type="button" disabled="@(selectedEnvironmentId is null)" @onclick="OpenReleaseHistoryPanel">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 3v6h6"/><path d="M12 7v5l3 2"/></svg>
                            @L("历史", "History")
                        </button>
                    </div>
                </div>

                @if (configMode == "env") {
                    <div class="cch-config-panel">
                        <div class="cch-config-tools">
                            <div class="cch-search-wrap compact-search">
                                <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></span>
                                <input class="cch-input" placeholder="@L("搜索配置键", "Search config keys")" @bind="configQuery" @bind:event="oninput" />
                            </div>
                            <button class="cch-button" type="button" @onclick="OpenNewConfig">
                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                                @L("新建配置项", "New config")
                            </button>
                        </div>
                        <div class="cch-table-card">
                            @{
                                var envConfigs = FilteredConfigs(project);
                            }
                            <table>
                                <thead>
                                    <tr>
                                        <th class="cch-row-number">#</th>
                                        <th class="cch-key-cell">KEY</th>
                                        <th class="cch-value-cell">@L("值", "Value") · @CurrentEnvironmentName(project)</th>
                                        <th class="hide-sm">@L("更新于", "Updated")</th>
                                        <th class="cch-actions-cell right">@L("操作", "Actions")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (envConfigs.Count == 0) {
                                        <tr><td colspan="5" class="cch-table-empty">@L("暂无数据", "No data")</td></tr>
                                    }
                                    @foreach (var (config, configIndex) in envConfigs.Select((config, configIndex) => (config, configIndex))) {
                                        <tr>
                                            <td class="cch-row-number">@(configIndex + 1)</td>
                                            <td class="cch-key-cell">
                                                <strong class="mono">@ConfigDisplayKey(config)</strong>
                                                @if (!string.IsNullOrWhiteSpace(config.Description)) {
                                                    <p>@config.Description</p>
                                                }
                                            </td>
                                            <td class="cch-value-cell">
                                                <input class="cch-input mono compact" value="@CurrentValue(config)" @onchange="e => SaveDraftValueAsync(project, config, selectedEnvironmentId!.Value, e.Value?.ToString() ?? string.Empty)" />
                                            </td>
                                            <td class="mono hide-sm">@FormatDate(project.CreatedAt)</td>
                                            <td class="cch-actions-cell right">
                                                <button class="cch-icon-button" type="button" @onclick="() => OpenEditConfig(config)" aria-label="@L("编辑", "Edit")">
                                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                                </button>
                                                <button class="cch-icon-button danger-text" type="button" @onclick="() => deleteConfigTarget = config.Id" aria-label="@L("删除", "Delete")">
                                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else {
                    var visibleConfigs = FilteredConfigs(project);
                    var selectedConfig = visibleConfigs.FirstOrDefault(item => item.Id == selectedConfigurationId) ?? visibleConfigs.FirstOrDefault();
                    <div class="cch-config-split">
                    <aside class="cch-config-list">
                        <header>
                            <span>@L("选择配置项", "Select config")</span>
                            <button class="cch-icon-button" type="button" @onclick="OpenNewConfig" aria-label="@L("新建配置项", "New config")">
                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                            </button>
                        </header>
                        <div class="cch-config-list-search">
                            <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></span>
                            <input class="cch-input compact mono" placeholder="@L("搜索配置键", "Search config keys")" @bind="configQuery" @bind:event="oninput" />
                        </div>
                        @if (visibleConfigs.Count == 0) {
                            <div class="cch-config-list-empty">
                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.5-9.17 4.17a2 2 0 0 1-1.66 0L2 12.5"/><path d="m22 17.5-9.17 4.17a2 2 0 0 1-1.66 0L2 17.5"/></svg>
                                <strong>@L("还没有配置项", "No configs yet")</strong>
                                <span>@L("新建后会显示在这里", "New configs will appear here")</span>
                            </div>
                        }
                        @foreach (var config in visibleConfigs) {
                            <button class="cch-config-list-item desktop-inline @(selectedConfig?.Id == config.Id ? "active" : null)" type="button" @onclick="() => selectedConfigurationId = config.Id">@ConfigDisplayKey(config)</button>
                            <button class="cch-config-list-item mobile-sheet-trigger @(selectedConfig?.Id == config.Id ? "active" : null)" type="button" @onclick="() => OpenConfigValueSheet(config)">@ConfigDisplayKey(config)</button>
                        }
                    </aside>
                    <section class="cch-config-detail desktop-inline">
                        @if (selectedConfig is null) {
                            <div class="cch-empty cch-config-empty-state inner">
                                <span class="cch-empty-icon">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/><path d="M4 7.5 12 3l8 4.5-8 4.5Z"/><path d="M4 12.5 12 17l8-4.5"/></svg>
                                </span>
                                <h3>@L("还没有配置项", "No configs yet")</h3>
                                <p>@L("创建后可在这里维护各环境的配置值", "Create one to manage values across environments")</p>
                                <button class="cch-button outline" type="button" @onclick="OpenNewConfig">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                                    @L("新建配置项", "New config")
                                </button>
                            </div>
                        }
                        else {
                            <div class="cch-detail-head">
                                <div>
                                    <h3 class="mono">@ConfigDisplayKey(selectedConfig)</h3>
                                    <p>@(string.IsNullOrWhiteSpace(selectedConfig.Description) ? L("各环境取值", "Values across environments") : selectedConfig.Description)</p>
                                </div>
                                <div>
                                    <button class="cch-icon-button" type="button" @onclick="() => OpenEditConfig(selectedConfig)" aria-label="@L("编辑", "Edit")">
                                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                    </button>
                                    <button class="cch-icon-button danger-text" type="button" @onclick="() => deleteConfigTarget = selectedConfig.Id" aria-label="@L("删除", "Delete")">
                                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="cch-env-value-list">
                                <p class="mono">@L("各环境取值", "Values across environments")</p>
                                @foreach (var env in project.Environments) {
                                    var value = selectedConfig.Values.SingleOrDefault(item => item.EnvironmentId == env.Id)?.DisplayValue ?? string.Empty;
                                    <label>
                                        <span><i style="@DotStyle(env.Key)"></i>@env.Name</span>
                                        <input class="cch-input mono compact" value="@value" @onchange="e => SaveDraftValueAsync(project, selectedConfig, env.Id, e.Value?.ToString() ?? string.Empty)" />
                                    </label>
                                }
                            </div>
                        }
                    </section>
                </div>
                    @if (configValueSheetOpen && selectedConfig is not null) {
                        <div class="cch-modal-root cch-config-value-sheet-root">
                            <button class="cch-modal-scrim" type="button" @onclick="CloseConfigValueSheet" aria-label="@L("关闭", "Close")"></button>
                            <section class="cch-modal cch-config-value-sheet" role="dialog" aria-modal="true" aria-label="@L("各环境取值", "Values across environments")">
                                <header class="cch-modal-header">
                                    <div>
                                        <h2 class="mono">@ConfigDisplayKey(selectedConfig)</h2>
                                        <p>@(string.IsNullOrWhiteSpace(selectedConfig.Description) ? L("各环境取值", "Values across environments") : selectedConfig.Description)</p>
                                    </div>
                                    <button type="button" class="cch-icon-button" @onclick="CloseConfigValueSheet" aria-label="@L("关闭", "Close")">
                                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                    </button>
                                </header>
                                <div class="cch-modal-body">
                                    <div class="cch-detail-head">
                                        <span class="mono">@L("各环境取值", "Values across environments")</span>
                                        <div>
                                            <button class="cch-icon-button" type="button" @onclick="() => OpenEditConfig(selectedConfig)" aria-label="@L("编辑", "Edit")">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                            </button>
                                            <button class="cch-icon-button danger-text" type="button" @onclick="() => deleteConfigTarget = selectedConfig.Id" aria-label="@L("删除", "Delete")">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="cch-env-value-list">
                                        @foreach (var env in project.Environments) {
                                            var value = selectedConfig.Values.SingleOrDefault(item => item.EnvironmentId == env.Id)?.DisplayValue ?? string.Empty;
                                            <label>
                                                <span><i style="@DotStyle(env.Key)"></i>@env.Name</span>
                                                <input class="cch-input mono compact" value="@value" @onchange="e => SaveDraftValueAsync(project, selectedConfig, env.Id, e.Value?.ToString() ?? string.Empty)" />
                                            </label>
                                        }
                                    </div>
                                </div>
                            </section>
                        </div>
                    }
            }
        }
        }
    </div>
}
else {
    <div class="cch-workbench cch-projects-workbench">
        <div class="cch-page-head">
            <div>
                <h1>@L("项目管理", "Projects")</h1>
                <p>@projects.Count @L("个项目 · 管理所有项目及其环境", "projects · Manage all projects and environments")</p>
            </div>
            <button class="cch-button large" type="button" @onclick="OpenNewProject">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                @L("新建项目", "New project")
            </button>
        </div>

        <div class="cch-search-wrap">
            <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></span>
            <input class="cch-input" placeholder="@L("搜索项目名称或标识", "Search by name or key")" @bind="projectQuery" @bind:event="oninput" />
        </div>

        @if (FilteredProjects().Count == 0) {
            <div class="cch-empty">@L("暂无数据", "No data")</div>
        }
        else {
            <div class="cch-project-grid">
                @foreach (var project in FilteredProjects()) {
                    <article class="cch-project-card">
                        <div class="cch-card-top">
                            <div>
                                <h3>@project.Name</h3>
                                <p class="mono">@project.Key</p>
                            </div>
                            <div class="cch-card-actions">
                                <button class="cch-icon-button" type="button" @onclick="() => OpenEditProject(project)" aria-label="@L("编辑", "Edit")">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                </button>
                                <button class="cch-icon-button danger-text" type="button" @onclick="() => deleteProjectTarget = project.Id" aria-label="@L("删除", "Delete")">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                </button>
                            </div>
                        </div>
                        <p class="cch-card-desc">@(string.IsNullOrWhiteSpace(project.Description) ? "—" : project.Description)</p>
                        <div class="cch-env-chips">
                            @if (project.Environments?.Count > 0) {
                                @foreach (var env in project.Environments) {
                                    <span><i style="@DotStyle(env.Key)"></i>@env.Name</span>
                                }
                            }
                            else {
                                <small>—</small>
                            }
                        </div>
                        <div class="cch-card-meta">
                            <span class="mono">@project.EnvironmentCount @L("个环境", "envs") · @project.ConfigurationCount @L("项配置", "configs")</span>
                        </div>
                        <div class="cch-card-bottom">
                            <span>@L("创建于", "Created") @FormatDate(project.CreatedAt)</span>
                            <div class="cch-card-actions">
                                <button class="cch-button outline small" type="button" @onclick="() => OpenAccessKeyPanel(project.Id)">@L("访问密钥", "Access key")</button>
                                <button class="cch-button outline small" type="button" @onclick="() => GoConfig(project.Id)">@L("管理配置", "Manage config")</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
}

@if (projectModalOpen) {
    <div class="cch-modal-root">
        <button class="cch-modal-scrim" type="button" @onclick="CloseProjectModal" aria-label="@L("关闭", "Close")"></button>
        <section class="cch-modal project-modal" role="dialog" aria-modal="true" aria-label="@ProjectModalTitle">
            <header class="cch-modal-header">
                <h2>@ProjectModalTitle</h2>
                <button type="button" class="cch-icon-button" @onclick="CloseProjectModal" aria-label="@L("关闭", "Close")">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </header>
            <div class="cch-modal-body">
                <label class="cch-field">
                    <span>@L("名称", "Name")</span>
                    <input class="cch-input" @bind="projectForm.Name" />
                </label>
                <label class="cch-field">
                    <span>@L("标识", "Key")</span>
                    <input class="cch-input mono" @bind="projectForm.Key" />
                    <small>@L("项目唯一标识，用于 API 调用", "Unique project key for API calls")</small>
                </label>
                <label class="cch-field">
                    <span>@L("描述", "Description") <em>@L("选填", "Optional")</em></span>
                    <textarea class="cch-input" rows="2" @bind="projectForm.Description"></textarea>
                </label>
                @if (editingProjectId is null) {
                    <label class="cch-field">
                        <span>@L("环境", "Environments")</span>
                        <input class="cch-input" placeholder="dev,test,prod" @bind="projectForm.EnvironmentNames" />
                        <small>@L("多个环境用逗号分隔", "Separate environments with commas")</small>
                    </label>
                }
                @if (!string.IsNullOrWhiteSpace(formError)) {
                    <p class="cch-error">@formError</p>
                }
            </div>
            <footer class="cch-modal-footer">
                <button class="cch-button outline" type="button" @onclick="CloseProjectModal">@L("取消", "Cancel")</button>
                <button class="cch-button" type="button" @onclick="SaveProjectAsync">@L("保存", "Save")</button>
            </footer>
        </section>
    </div>
}

@if (environmentModalOpen && SelectedProject is not null) {
    <div class="cch-modal-root">
        <button class="cch-modal-scrim" type="button" @onclick="CloseEnvironmentModal" aria-label="@L("关闭", "Close")"></button>
        <section class="cch-modal project-modal" role="dialog" aria-modal="true" aria-label="@L("新增环境", "New environment")">
            <header class="cch-modal-header">
                <h2>@L("新增环境", "New environment")</h2>
                <button type="button" class="cch-icon-button" @onclick="CloseEnvironmentModal" aria-label="@L("关闭", "Close")">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </header>
            <div class="cch-modal-body">
                <label class="cch-field">
                    <span>@L("名称", "Name")</span>
                    <input class="cch-input" @bind="environmentForm.Name" />
                </label>
                <label class="cch-field">
                    <span>@L("标识", "Key")</span>
                    <input class="cch-input mono" @bind="environmentForm.Key" />
                </label>
                @if (!string.IsNullOrWhiteSpace(formError)) {
                    <p class="cch-error">@formError</p>
                }
            </div>
            <footer class="cch-modal-footer">
                <button class="cch-button outline" type="button" @onclick="CloseEnvironmentModal">@L("取消", "Cancel")</button>
                <button class="cch-button" type="button" @onclick="SaveEnvironmentAsync">@L("保存", "Save")</button>
            </footer>
        </section>
    </div>
}

@if (configModalOpen && SelectedProject is not null) {
    <div class="cch-modal-root">
        <button class="cch-modal-scrim" type="button" @onclick="CloseConfigModal" aria-label="@L("关闭", "Close")"></button>
        <section class="cch-modal config-modal" role="dialog" aria-modal="true" aria-label="@ConfigModalTitle">
            <header class="cch-modal-header">
                <h2>@ConfigModalTitle</h2>
                <button type="button" class="cch-icon-button" @onclick="CloseConfigModal" aria-label="@L("关闭", "Close")">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </header>
            <div class="cch-modal-body">
                <label class="cch-field">
                    <span>@L("标识", "Key")</span>
                    <input class="cch-input mono" placeholder="database.host" @bind="configForm.Key" />
                    <small>@L("配置键，项目内唯一", "Configuration key, unique within the project")</small>
                </label>
                <label class="cch-field">
                    <span>@L("描述", "Description") <em>@L("选填", "Optional")</em></span>
                    <textarea class="cch-input" rows="2" @bind="configForm.Description"></textarea>
                </label>
                <label class="cch-check">
                    <input type="checkbox" @bind="configForm.IsSensitive" />
                    <span>@L("敏感配置", "Sensitive config")</span>
                </label>
                <div class="cch-env-values">
                    <p>@L("环境取值", "Environment values")</p>
                    @foreach (var env in SelectedProject.Environments) {
                        <label>
                            <span><i style="@DotStyle(env.Key)"></i>@env.Name</span>
                            <input class="cch-input mono compact" value="@GetConfigFormValue(env.Id)" @oninput="e => SetConfigFormValue(env.Id, e.Value?.ToString() ?? string.Empty)" />
                        </label>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(formError)) {
                    <p class="cch-error">@formError</p>
                }
            </div>
            <footer class="cch-modal-footer">
                <button class="cch-button outline" type="button" @onclick="CloseConfigModal">@L("取消", "Cancel")</button>
                <button class="cch-button" type="button" @onclick="SaveConfigAsync">@L("保存", "Save")</button>
            </footer>
        </section>
    </div>
}

@if (publishPanelOpen && SelectedProject is { } publishProject && CurrentEnvironment is { } publishEnvironment) {
    <div class="cch-modal-root">
        <button class="cch-modal-scrim" type="button" @onclick="ClosePublishPanel" aria-label="@L("关闭", "Close")"></button>
        <section class="cch-modal release-modal" role="dialog" aria-modal="true" aria-label="@L("发布环境配置", "Publish environment configuration")">
            <header class="cch-modal-header">
                <h2>@L("发布环境配置", "Publish environment configuration")</h2>
                <button type="button" class="cch-icon-button" @onclick="ClosePublishPanel" aria-label="@L("关闭", "Close")">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </header>
            <div class="cch-modal-body">
                <p class="cch-muted-line">@publishProject.Name / <span class="mono">@publishEnvironment.Key</span></p>
                @if (!string.IsNullOrWhiteSpace(panelError)) {
                    <p class="cch-error" role="alert">@panelError</p>
                }
                @if (LatestRelease is null) {
                    <p class="cch-warning">@L("当前环境还没有发布版本，本次发布将创建首个快照。", "This environment has no releases yet. This publish will create the first snapshot.")</p>
                }
                <div class="cch-table-card">
                    <table>
                        <thead>
                            <tr>
                                <th>KEY</th>
                                <th>@L("差异", "Diff")</th>
                                <th>@L("最新发布值", "Published")</th>
                                <th>@L("草稿值", "Draft")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in DiffRows) {
                                <tr>
                                    <td class="mono">@row.ConfigurationKey</td>
                                    <td><span class="cch-status-pill @row.StatusCssClass">@row.StatusText</span></td>
                                    <td>@(row.HasLatestReleaseValue ? row.LatestReleaseValue : L("未设置", "Not set"))</td>
                                    <td>@(row.HasDraftValue ? row.DraftValue : L("未设置", "Not set"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <label class="cch-field">
                    <span>@L("发布备注", "Release note")</span>
                    <textarea class="cch-input" rows="2" @bind="publishForm.Note"></textarea>
                </label>
                <label class="cch-field">
                    <span>@L("发布人", "Published by")</span>
                    <input class="cch-input" @bind="publishForm.PublishedBy" />
                </label>
            </div>
            <footer class="cch-modal-footer">
                <button class="cch-button outline" type="button" @onclick="ClosePublishPanel">@L("取消", "Cancel")</button>
                <button class="cch-button" type="button" disabled="@isPublishing" @onclick="PublishEnvironmentAsync">@(isPublishing ? L("正在发布...", "Publishing...") : L("发布配置", "Publish configuration"))</button>
            </footer>
        </section>
    </div>
}

@if (releaseHistoryPanelOpen && SelectedProject is { } historyProject && CurrentEnvironment is { } historyEnvironment) {
