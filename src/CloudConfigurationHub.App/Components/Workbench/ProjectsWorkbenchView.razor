@inherits ManagementWorkbenchComponentBase

    <div class="cch-workbench cch-projects-workbench">
        <div class="cch-page-head">
            <div>
                <h1>@L("项目管理", "Projects")</h1>
                <p>@projects.Count @L("个项目 · 管理所有项目及其环境", "projects · Manage all projects and environments")</p>
            </div>
            <button class="cch-button large" type="button" @onclick="OpenNewProject">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                @L("新建项目", "New project")
            </button>
        </div>

        <div class="cch-search-wrap">
            <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></span>
            <input class="cch-input" placeholder="@L("搜索项目名称或标识", "Search by name or key")" @bind="projectQuery" @bind:event="oninput" />
        </div>

        @if (FilteredProjects().Count == 0) {
            <div class="cch-empty">@L("暂无数据", "No data")</div>
        }
        else {
            <div class="cch-project-grid">
                @foreach (var project in FilteredProjects()) {
                    <article class="cch-project-card">
                        <div class="cch-card-top">
                            <div>
                                <h3>@project.Name</h3>
                                <p class="mono">@project.Key</p>
                            </div>
                            <div class="cch-card-actions">
                                <button class="cch-icon-button" type="button" @onclick="() => OpenEditProject(project)" aria-label="@L("编辑", "Edit")">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                </button>
                                <button class="cch-icon-button danger-text" type="button" @onclick="() => deleteProjectTarget = project.Id" aria-label="@L("删除", "Delete")">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                </button>
                            </div>
                        </div>
                        <p class="cch-card-desc">@(string.IsNullOrWhiteSpace(project.Description) ? "—" : project.Description)</p>
                        <div class="cch-env-chips">
                            @if (project.Environments?.Count > 0) {
                                @foreach (var env in project.Environments) {
                                    <span><i style="@DotStyle(env.Key)"></i>@env.Name</span>
                                }
                            }
                            else {
                                <small>—</small>
                            }
                        </div>
                        <div class="cch-card-meta">
                            <span class="mono">@project.EnvironmentCount @L("个环境", "envs") · @project.ConfigurationCount @L("项配置", "configs")</span>
                        </div>
                        <div class="cch-card-bottom">
                            <span>@L("创建于", "Created") @FormatDate(project.CreatedAt)</span>
                            <div class="cch-card-actions">
                                <button class="cch-button outline small" type="button" @onclick="() => OpenAccessKeyPanel(project.Id)">@L("访问密钥", "Access key")</button>
                                <button class="cch-button outline small" type="button" @onclick="() => GoConfig(project.Id)">@L("管理配置", "Manage config")</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

<ProjectEditorDialog />
<AccessKeyDialog />
<DeleteConfirmationDialog />
